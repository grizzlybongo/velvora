// Velvora — Prisma Schema
// Database: PostgreSQL (Supabase / Railway / Neon / any Postgres host)
//
// In Prisma v7, the connection URL lives in prisma.config.ts.
// Run `npm run prisma:migrate` after changing models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─── Product ────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  status      ProductStatus @default(DRAFT)
  price       Decimal       @db.Decimal(10, 2)
  compareAt   Decimal?      @db.Decimal(10, 2) // original / strike-through price
  currency    String        @default("GBP") @db.VarChar(3)
  featured    Boolean       @default(false)

  images      ProductImage[]
  variants    Variant[]
  collections CollectionProduct[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([featured])
}

// ─── Product Image ──────────────────────────────────────────────

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

// ─── Variant ────────────────────────────────────────────────────

model Variant {
  id        String  @id @default(cuid())
  sku       String  @unique
  name      String           // e.g. "50ml", "100ml", "Travel Size"
  price     Decimal @db.Decimal(10, 2)
  inventory Int     @default(0)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─── Collection ─────────────────────────────────────────────────

model Collection {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?

  products    CollectionProduct[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Collection ↔ Product (ordered join) ────────────────────────

model CollectionProduct {
  id           String     @id @default(cuid())
  sortOrder    Int        @default(0)

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
}
