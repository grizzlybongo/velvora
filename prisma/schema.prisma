// Velvora — Prisma Schema
// Database: PostgreSQL (Supabase / Railway / Neon / any Postgres host)
//
// In Prisma v7, the connection URL lives in prisma.config.ts.
// Run `npm run prisma:migrate` after changing models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderType {
  ONLINE
  IN_STORE
  WHOLESALE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  CARD
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  tagline     String?
  description String
  family      String?
  scentNotes  String[]            @default([])
  status      ProductStatus       @default(DRAFT)
  price       Decimal             @db.Decimal(10, 3) // display "from" price = lowest variant price
  featured    Boolean             @default(false)
  cardColor   String?
  textColor   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  images      ProductImage[]
  variants    Variant[]
  collections CollectionProduct[]

  @@index([status, featured])
  @@index([family])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Variant {
  id         String      @id @default(cuid())
  sku        String      @unique
  name       String // "30ml" | "50ml" | "100ml"
  sortOrder  Int         @default(0)
  price      Decimal     @db.Decimal(10, 3)
  compareAt  Decimal?    @db.Decimal(10, 3)
  inventory  Int         @default(0)
  threshold  Int         @default(5)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId, sortOrder])
}

model Collection {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  description        String?
  imageUrl           String?
  visible            Boolean             @default(true)
  featuredOnHomepage Boolean             @default(false)
  showInNav          Boolean             @default(false)
  sortOrder          Int                 @default(0)
  metaTitle          String?
  metaDescription    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  products           CollectionProduct[]

  @@index([visible, sortOrder])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  sortOrder    Int        @default(0)
  collectionId String
  productId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique // always stored trimmed + lowercase (enforced by CHECK)
  phone     String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id            String        @id @default(cuid()) // the ONLY id ever used in public URLs
  orderNumber   Int           @unique @default(autoincrement()) // shown as ORD-<n>; never a public lookup key
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  email         String
  phone         String?
  type          OrderType     @default(ONLINE)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentRef    String?       @unique
  subtotal      Decimal       @db.Decimal(10, 3)
  shippingFee   Decimal       @default(0) @db.Decimal(10, 3)
  total         Decimal       @db.Decimal(10, 3)
  address       String?
  city          String?
  country       String?
  postalCode    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([email])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantName String
  sku         String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 3)
  image       String?

  @@index([orderId])
  @@index([variantId])
}

model BlogPost {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  excerpt     String
  content     String
  category    String
  image       String?
  readTime    String?
  author      String     @default("Maison Velvora")
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique // trimmed + lowercase (enforced by CHECK)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}
